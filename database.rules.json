{
  "rules": {
    "requests": {
      ".read": true,
      "$date": {
        "$id": {
          ".write": true,
          ".validate": "newData.hasChildren(['cccd','name','dob','sender','handler','status','ts'])",
          "status": { ".validate": "newData.val()=='chua_kiem_tra'||newData.val()=='chua_kham'||newData.val()=='da_kham'" }
        }
      }
    }
  }
}
